# ---------------------------------------------------------------------------
# LamiTheMigrantCEO — environment variables
# Copy this file to `.env.local` and fill in the real values. Never commit
# `.env.local`. On Vercel, add these under Project Settings → Environment
# Variables. Secrets (service role, Stripe secret, Resend, webhook secret)
# are SERVER ONLY — do not prefix them with NEXT_PUBLIC_.
# ---------------------------------------------------------------------------

# --- Supabase (project: mnhpprzuheyowtiuibat) -------------------------------
# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://mnhpprzuheyowtiuibat.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Server only — full access, bypasses row level security. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --- Site ------------------------------------------------------------------
# The canonical public URL. Used for auth redirects, sitemap, OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (GBP, test keys until Lami confirms the live account) ----------
STRIPE_SECRET_KEY=sk_test_your_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret

# --- Resend (transactional email) ------------------------------------------
# Set as a Supabase secret for the edge functions too:
#   supabase secrets set RESEND_API_KEY=...
RESEND_API_KEY=re_your_key
# Verified sending address. Falls back to Resend's onboarding sender until
# the domain's SPF + DKIM records are live.
RESEND_FROM_EMAIL=Lami <hello@lamithemigrantceo.com>
# Where new-enquiry notifications are sent.
ENQUIRY_NOTIFY_EMAIL=aniekaneazy@gmail.com
